{
	"name": "@kyudaisai/pamphlet-viewer",
	"version": "0.1.0-alpha.7",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kyudaisai-committee/pamphlet-viewer.git"
	},
	"files": [
		"dist/library"
	],
	"type": "module",
	"main": "./dist/library/pamphlet-viewer.js",
	"types": "./dist/library/pamphlet-viewer.d.ts",
	"exports": {
		".": {
			"types": "./dist/library/pamphlet-viewer.d.ts",
			"import": "./dist/library/pamphlet-viewer.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && pnpm build:library",
		"build:library": "vite build --config vite.library.config.ts",
		"changeset": "changeset",
		"changeset:version": "changeset version && pnpm install --lockfile-only && pnpm format",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"format": "oxfmt",
		"fmt": "oxfmt",
		"lint": "eslint . && cspell .",
		"test": "pnpm build:library && vitest run",
		"verify": "pnpm exec oxfmt --check && pnpm check && pnpm lint && pnpm test && pnpm build",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@embedpdf/pdfium": "2.15.1",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.60.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.5",
		"cspell": "^10.4.0",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.73.0",
		"rolldown-plugin-dts": "^0.28.8",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.12.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.14.0"
}
