{
	"name": "pamphlet-viewer",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/library/types/entry.d.ts",
			"import": "./dist/library/pamphlet-viewer.js"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && pnpm build:library",
		"build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"format": "oxfmt",
		"fmt": "oxfmt",
		"lint": "eslint . && cspell .",
		"test": "pnpm build:library && vitest run",
		"verify": "pnpm exec oxfmt --check && pnpm check && pnpm lint && pnpm test && pnpm build",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@embedpdf/pdfium": "2.15.1",
		"@lucide/svelte": "^1.58.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^5.0.5",
		"cspell": "^10.4.0",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jiti": "^2.7.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.73.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.12.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.14.0"
}
