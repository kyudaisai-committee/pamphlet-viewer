{
	"name": "@kyudaisai/pamphlet-viewer",
	"version": "0.2.1",
	"license": "MIT",
	"author": "九大祭実行委員会, kurage (@umitsukidev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kyudaisai-committee/pamphlet-viewer.git"
	},
	"files": [
		"dist/library",
		"licenses",
		"NOTICE",
		"THIRD_PARTY_NOTICES.txt"
	],
	"type": "module",
	"main": "./dist/library/pamphlet-viewer.js",
	"types": "./dist/library/pamphlet-viewer.d.ts",
	"exports": {
		".": {
			"types": "./dist/library/pamphlet-viewer.d.ts",
			"import": "./dist/library/pamphlet-viewer.js"
		},
		"./register": {
			"types": "./dist/library/register.d.ts",
			"import": "./dist/library/register.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && pnpm build:library",
		"build:library": "vite build --config vite.library.config.ts",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy baseLocale",
		"changeset": "changeset",
		"changeset:version": "changeset version && pnpm install --lockfile-only && pnpm format",
		"preview": "vite preview",
		"check": "pnpm i18n:compile && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"format": "oxfmt && node scripts/sort-txt.ts cspell.txt",
		"fmt": "pnpm run format",
		"lint": "eslint . && cspell .",
		"test": "pnpm build:library && vitest run",
		"verify": "pnpm exec oxfmt --check && pnpm check && pnpm lint && pnpm test && pnpm build",
		"prepare": "lefthook install",
		"prepack": "pnpm build:library"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@embedpdf/pdfium": "^2.15.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.2",
		"@inlang/plugin-m-function-matcher": "^2.4.3",
		"@inlang/plugin-message-format": "^4.6.0",
		"@lucide/svelte": "^1.73.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tsconfig/svelte": "^5.0.9",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.0",
		"cspell": "^10.5.0",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.78.0",
		"rolldown-plugin-dts": "^0.30.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.21.0"
}
